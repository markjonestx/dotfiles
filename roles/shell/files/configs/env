# vim: syntax=bash
# Because TMUX can break things
if [ $TERM = tmux-256color ]; then
    if ! infocmp tmux-256color >/dev/null 2>&1; then
        export TERM='xterm-256color'
    fi
fi


# PATH configuration

pathadd() {
    if [ -d "$(readlink -f $1)" ] && [[ ":$PATH:" != *":$(readlink -f $1):"* ]]; then
        PATH="${PATH:+"$PATH:"}$1"
    fi
}

pathadd "${HOME}/.local/bin"
pathadd "/opt/go/bin"
pathadd "${HOME}/go/bin"
pathadd "${HOME}/.local/go/bin"
pathadd "${HOME}/.fzf/bn"
pathadd "/opt/homebrew/bin"
pathadd "${HOME}/.local/share/Jetbrains/Toolbox/scripts"

if [ -d "$HOME/.cargo" ]; then
    . "$HOME/.cargo/env"
fi

# Setup Editor
if command -v nvim &> /dev/null; then
    export EDITOR=$(which nvim)
    export MANPAGER="${EDITOR} +Man!"
    alias vim=nvim
elif command -v vim &> /dev/null; then
    echo "Warning- VIM"
    export EDITOR=$(which vim)
    if command -v bat &> /dev/null; then
        export MANPAGER="sh -c 'col -bx | bat -l man -p'"
    fi
else
    echo "ERROR- No text editor found!"
fi

# FZF setup
if [[ -n $TMUX ]]; then
    export PFZF=$(which fzf-tmux)
else
    export PFZF=$(which fzf)
fi

export FZF_DEFAULT_OPTS=" \
--color=fg:#cad3f5,header:#ed8796,info:#c6a0f6,pointer:#f4dbd6 \
--color=marker:#f4dbd6,fg+:#cad3f5,prompt:#c6a0f6,hl+:#ed8796"

# LS setup
if command -v lsd &> /dev/null; then

    if [ "$TERM" = "linux" ]; then
        export LSCMD='lsd --icon=never'
    else
        export LSCMD='lsd'
    fi

elif command -v gls &> /dev/null; then
    export LSCMD='gls'
else
    export LSCMD='ls'
fi
